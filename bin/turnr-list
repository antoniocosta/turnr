#!/usr/bin/env python3
"""turnr-list: print the turns of a Claude Code session, with compaction dividers.

    turnr-list <session-id | path/to/session.jsonl>
    turnr-list --json <...>
"""
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import turns  # noqa: E402


def main(argv):
    as_json = "--json" in argv
    args = [a for a in argv if not a.startswith("--")]
    if len(args) != 1:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    target = args[0]
    path = target if os.path.isfile(target) else turns.find_session_file(target)
    if not path:
        print("turnr: no session file for %r" % target, file=sys.stderr)
        return 1
    items = turns.load_cached(path) if "--cache" in argv else turns.load(path)
    print(json.dumps(items) if as_json else turns.render(items, int(os.environ.get("COLUMNS", "100"))))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
